OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Groq (free tier — fastest LPU inference). Used for nano/fast tier LLM + voice STT.
# Sign up: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo

# Tier overrides (optional)
JARVIS_TIER_NANO=google/gemini-2.5-flash-lite
JARVIS_TIER_FAST=google/gemini-2.5-flash-lite
JARVIS_TIER_SMART=google/gemini-2.5-flash
JARVIS_TIER_POWER=anthropic/claude-sonnet-4-6
JARVIS_TIER_VISION=google/gemini-2.5-flash

# Offline (Ollama)
JARVIS_MODEL=qwen3.5:4b
JARVIS_OLLAMA_URL=http://localhost:11434/api/chat

# Vision agent
JARVIS_AUTO_CAPTURE=true              # auto-screenshot after open_app
JARVIS_CAPTURE_REGION=active_window   # active_window | full

# Voice mode
OPENAI_API_KEY=                       # for Whisper STT
ELEVENLABS_API_KEY=                   # for TTS
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5
JARVIS_VOICE_MODE=off                 # off | hotkey | wake | both
JARVIS_HOTKEY=<ctrl>+<space>
JARVIS_WAKE_MODEL=hey_jarvis_v0.1
JARVIS_VOICE_LANG=en
JARVIS_VAD_SILENCE_MS=600

# Desktop automation (Phase 5) — DISABLED by default
JARVIS_ALLOW_AUTOMATION=false           # set to true to enable click/type/etc.
JARVIS_AUTOMATION_DRY_RUN=false         # log intended actions, do not execute
JARVIS_AUTOMATION_ALLOWLIST=firefox,google-chrome,chromium,code,gnome-text-editor,gnome-terminal,kitty,alacritty,nautilus,postman
JARVIS_ACTION_BUDGET=30                 # max actions per task
JARVIS_AUTOMATION_CONFIRM_PHRASE=yes do it
